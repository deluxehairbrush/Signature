# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=signature_db
POSTGRES_USER=signature_user
POSTGRES_PASSWORD=signature_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS
FRONTEND_URL=http://localhost:3000

# AI Service
AI_SERVICE_URL=http://localhost:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME=30
JWT_REFRESH_TOKEN_LIFETIME=7

# Google Sign-In (Google Identity Services ID token audience)
GOOGLE_OAUTH_CLIENT_ID=

# Media storage (portfolio image uploads) — S3-compatible object storage.
# Leave AWS_STORAGE_BUCKET_NAME blank for local dev (uploads go to
# backend/media/ on disk). Set all of these in production — see
# DEPLOYMENT.md §1.4 for a Cloudflare R2 walkthrough.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=
